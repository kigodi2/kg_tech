        .password-toggle svg {
            width: 16px;
            height: 16px;
            display: block;
            color: #8b95a7;
        }

        .password-toggle .icon-eye-off {
            display: none;
        }

        .password-toggle.is-visible .icon-eye {
            display: none;
        }

        .password-toggle.is-visible .icon-eye-off {
            display: block;
        }

        .login-meta {
